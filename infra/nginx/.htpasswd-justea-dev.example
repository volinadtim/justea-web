# Пример файла паролей dev-стенда. Настоящий файл в репозитории не лежит:
# его генерирует ansible (infra/ansible/tasks/dev-stand-htpasswd.yml) на сервере
# по пути /etc/nginx/.htpasswd-justea-dev из переменной dev_basic_auth_password.
#
# Формат: <логин>:<apr1-хеш>. Строку ниже можно получить руками так:
#   printf '%s' 'ПАРОЛЬ' | openssl passwd -apr1 -stdin
#
dev:$apr1$EXAMPLEx$0000000000000000000000
