# Публичный URL сайта (OG-теги, canonical, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://justea.ru

# Коды подтверждения прав в панелях вебмастеров.
# Пустые значения не выводятся в <head>. Получить — см. docs/seo/webmaster-setup.md.
# Переменные с префиксом NEXT_PUBLIC_ вшиваются на этапе `next build`:
# на проде их нужно передать в сборку, а не только в рантайм контейнера.
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
