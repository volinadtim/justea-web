# Публичный URL сайта (OG-теги, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://justea.ru

# Заявки на чайную церемонию (app/api/ceremony).
# Без этих переменных запись работает: заявка пишется в .data/ceremony-requests.jsonl,
# а письма печатаются в лог процесса.
# CEREMONY_DATA_DIR=.data
# Почта на домене justea появится позже, поэтому по умолчанию письма только
# печатаются в лог. Чтобы включить отправку, выставить resend и ключ.
# CEREMONY_MAIL_PROVIDER=log   # log | resend
# CEREMONY_MAIL_FROM=Justea <ceremony@justea.ru>
# CEREMONY_MAIL_TO=regina@justea.ru
# RESEND_API_KEY=
